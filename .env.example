# ----------------------------------------------------------------------------
# Ponto Wine — variáveis de ambiente
# Copie este ficheiro para `.env.local` e preencha os valores.
# Sem estas variáveis a aplicação corre em MODO DEMO (dados em localStorage).
# ----------------------------------------------------------------------------

# Supabase — URL do projeto (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — chave pública (anon). Segura para o browser, protegida por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role. SECRETA. Apenas em servidor / server actions.
# NUNCA exponha esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp de contacto (apenas dígitos, com indicativo). Ex.: 351915026512
NEXT_PUBLIC_WHATSAPP_NUMBER=351915026512
